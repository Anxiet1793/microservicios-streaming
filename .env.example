# Solo desarrollo local. npm run stack:setup genera .env sin sobrescribirlo.
COMPOSE_PROJECT_NAME=nevaro
# Limitar concurrencia de llamadas Docker; BuildKit puede paralelizar fases internas.
COMPOSE_PARALLEL_LIMIT=1
COMPOSE_BAKE=false
FRONTEND_PORT=8080
USERS_PORT=8081
CATALOG_PORT=8082
PLAYBACK_PORT=8083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Si cambias puertos, ajusta también estos orígenes y reconstruye frontend.
APP_ORIGIN=http://localhost:8080
MEDIA_ORIGIN=http://localhost:9000
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO
MINIO_ACCESS_KEY=REEMPLAZAR_CON_ID_ALEATORIO
MINIO_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO
SESSION_SECRET=REEMPLAZAR_CON_64_HEX_ALEATORIOS
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=nevaro-local-1
JWT_ISSUER=users-service
JWT_AUDIENCE=streaming-services
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
DEMO_SEED_ENABLED=true
# Solo para las dos cuentas demo de este stack, nunca para producción.
SEED_PASSWORD=REEMPLAZAR_CON_PASSWORD_ALEATORIO
