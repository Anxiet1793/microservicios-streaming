# Desarrollo local. Para Atlas, usar su URI mongodb+srv:// en .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=catalog_service
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_QUERY_TIMEOUT_MS=5000
BULK_MAX_ITEMS=500
REQUEST_MAX_BYTES=5242880

# Trusted Users signer; local Node execution. Compose defaults to host.docker.internal.
# USERS_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=users-service
JWT_AUDIENCE=streaming-services
