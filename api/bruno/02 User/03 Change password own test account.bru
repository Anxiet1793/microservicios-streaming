meta {
  name: 03 Change password own test account
  type: http
  seq: 3
}

post {
  url: {{usersBaseUrl}}/api/v1/users/me/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{userPassword}}",
    "newPassword": "{{newPassword}}"
  }
}

script:pre-request {
  if (!(bru.getVar("accessToken") || bru.getEnvVar("accessToken"))) throw new Error("Login USER first");
}

script:post-response {
  if (res.getStatus() === 204) { bru.setVar("userPassword", bru.getVar("newPassword")); bru.setVar("accessToken", ""); }
}

tests {
  test("HTTP 204", function () { expect(res.getStatus()).to.equal(204); });
  
  test("Empty response", function () { expect(!res.getBody()).to.equal(true); });
  
  test("No database or password fields", function () {
    const visit = value => value && typeof value === "object" && Object.entries(value).some(([key, child]) => ["password", "passwordHash", "password_hash", "tokenHash", "_id"].includes(key) || visit(child));
    expect(Boolean(visit(res.getBody()))).to.equal(false);
  });
}

docs {
  Servicio: users. Variables e IDs capturados en memoria. Ejecutar el plan demo para preparar las dependencias de esta petición.
}

