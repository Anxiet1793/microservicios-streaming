{
  "name": "nevaro-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3003",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "types:generate": "node --import tsx scripts/generate-types.ts",
    "dev:setup": "node scripts/setup.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "server-only": "0.0.1",
    "ioredis": "^5.8.2",
    "@tanstack/react-query": "^5.90.0",
    "react-hook-form": "^7.65.0",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^0.544.0",
    "@fontsource/manrope": "^5.2.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@playwright/test": "^1.56.0",
    "openapi-typescript": "^7.10.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^27.0.0",
    "prettier": "3.9.10"
  }
}
