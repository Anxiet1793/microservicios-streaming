meta {
  name: 05 Refresh URL
  type: http
  seq: 5
}

post {
  url: {{playbackBaseUrl}}/api/v1/playback/sessions/{{sessionId}}/refresh-url
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  if (!(bru.getVar("accessToken") || bru.getEnvVar("accessToken"))) throw new Error("Login USER first");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  
  test("Response JSON Schema from OpenAPI", function () {
    const schema = {
    "type": "object",
    "required": [
      "playback"
    ],
    "additionalProperties": false,
    "properties": {
      "playback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "expiresIn"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          }
        }
      }
    }
  };
    expect(res.getBody()).to.have.jsonSchema(schema);
  });
  
  test("No database or password fields", function () {
    const visit = value => value && typeof value === "object" && Object.entries(value).some(([key, child]) => ["password", "passwordHash", "password_hash", "tokenHash", "_id"].includes(key) || visit(child));
    expect(Boolean(visit(res.getBody()))).to.equal(false);
  });
}

docs {
  Servicio: playback. Variables e IDs capturados en memoria. Ejecutar el plan demo para preparar las dependencias de esta petición.
}

