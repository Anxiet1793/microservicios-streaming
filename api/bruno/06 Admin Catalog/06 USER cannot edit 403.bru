meta {
  name: 06 USER cannot edit 403
  type: http
  seq: 6
}

patch {
  url: {{catalogBaseUrl}}/api/v1/catalog/{{tituloId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "ficha": {
      "title": "Forbidden"
    }
  }
}

script:pre-request {
  if (!(bru.getVar("accessToken") || bru.getEnvVar("accessToken"))) throw new Error("Login USER first");
}

tests {
  test("HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  
  test("Response JSON Schema from OpenAPI", function () {
    const schema = {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "issues": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "code"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  };
    expect(res.getBody()).to.have.jsonSchema(schema);
  });
  
  test("No database or password fields", function () {
    const visit = value => value && typeof value === "object" && Object.entries(value).some(([key, child]) => ["password", "passwordHash", "password_hash", "tokenHash", "_id"].includes(key) || visit(child));
    expect(Boolean(visit(res.getBody()))).to.equal(false);
  });
  
  test("Error code FORBIDDEN", function () { expect(res.getBody().error.code).to.equal("FORBIDDEN"); });
}

docs {
  Servicio: catalog. Variables e IDs capturados en memoria. Ejecutar el plan demo para preparar las dependencias de esta petición.
}

