# Ejecuta npm run dev:setup para generar .env local con secretos aleatorios.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3001
USERS_PORT=3001
POSTGRES_PORT=5433
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO
DATABASE_URL=postgresql://users:REEMPLAZAR_CON_SECRETO_ALEATORIO@127.0.0.1:5433/users_service
# PEM PKCS8/SPKI, entre comillas con saltos de línea escapados como \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=users-dev-1
JWT_ISSUER=users-service
JWT_AUDIENCE=streaming-services
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REQUEST_MAX_BYTES=16384
AUTH_RATE_WINDOW=900
AUTH_GLOBAL_LIMIT=200
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
# Exclusivamente para seed de desarrollo. Nunca hay una contraseña fija en código.
SEED_PASSWORD=
